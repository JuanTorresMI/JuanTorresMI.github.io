---
permalink: /sitemap.xml
layout: null
sitemap: false
---
{%- comment -%}
  Written out by hand rather than with jekyll-sitemap, so it works whatever plugin set the
  build happens to have. A page opts out with `sitemap: false` in its front matter.
  <lastmod> is only written when it is true: a page's `last_modified_at` if it sets one,
  otherwise the date scripts/lastmod.py found in git (the newest commit to the page or to a
  data file it reads, so /youtube/ moves with its daily snapshot); a post's date for posts;
  for a reefer lane, the week it was last quoted.
  Stamping every page with the build time would tell Google that everything changed on every
  push, and it stops trusting a sitemap's dates once they lie. A local build has no git
  dates unless you run lastmod.py first; those pages then simply list no date.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp: "p", "p.sitemap != false" -%}
{%- for p in pages -%}
{%- unless p.url contains "404" -%}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>
    {%- assign mod = p.last_modified_at | default: site.data.lastmod[p.path] -%}
    {%- if mod %}
    <lastmod>{{ mod | date_to_xmlschema }}</lastmod>
    {%- endif %}
    <changefreq>{% if p.url == "/" %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if p.url == "/" %}1.0{% elsif p.url contains "projects" %}0.8{% else %}0.6{% endif %}</priority>
  </url>
{%- endunless -%}
{%- endfor -%}
{%- for lane in site.reefer_lanes %}
  {%- assign l = site.data.live.reefer.lanes[lane.lane] %}
  <url>
    <loc>{{ lane.url | absolute_url | xml_escape }}</loc>
    {%- if l %}
    <lastmod>{{ l.last_iso | date_to_xmlschema }}</lastmod>
    {%- endif %}
    <changefreq>weekly</changefreq>
    <priority>0.5</priority>
  </url>
{%- endfor -%}
{%- comment %} Border crossings: their data is copied twice a day, so that copy's date is their lastmod.
  The Spanish pages carry sitemap: false until they're reviewed (see _config.yml). {% endcomment -%}
{%- assign crossings = site.border_crossings | concat: site.border_crossings_es | where_exp: "c", "c.sitemap != false" -%}
{%- for c in crossings %}
  <url>
    <loc>{{ c.url | absolute_url | xml_escape }}</loc>
    {%- if site.data.live.border %}
    <lastmod>{{ site.data.live.border.as_of_iso | date_to_xmlschema }}</lastmod>
    {%- endif %}
    <changefreq>daily</changefreq>
    <priority>0.5</priority>
  </url>
{%- endfor -%}
{%- for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}
</urlset>
