---
permalink: /sitemap.xml
layout: null
sitemap: false
---
{%- comment -%}
  Written by hand rather than with jekyll-sitemap, so it builds with any plugin set. A page opts
  out with `sitemap: false` in its front matter (redirects, /watching/, the 404).

  <lastmod> is only written when it is true:
    - a page: its `last_modified_at`, else the date scripts/lastmod.py found in git (the newest
      commit to the page or to a data file it reads, so /youtube/ moves with its daily snapshot);
    - a reefer lane: the week it was last quoted;
    - a border crossing (English and Spanish): the time of the last data copy;
    - a beef or pork cut (English and Spanish): the last day it traded;
    - a fed cattle region: the last weekly report with a price;
    - a post: its `last_modified_at`, else its date.
  Stamping every page with the build time would tell search engines everything changed on every
  push, and they stop trusting a sitemap's dates once those lie. A local build has no git dates
  unless lastmod.py ran first; those pages then list no date.
  No <changefreq> or <priority>: Google and Bing ignore both.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp: "p", "p.sitemap != false" -%}
{%- for p in pages -%}
{%- unless p.url contains "404" -%}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>
    {%- assign mod = p.last_modified_at | default: site.data.lastmod[p.path] -%}
    {%- if mod %}
    <lastmod>{{ mod | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endunless -%}
{%- endfor -%}
{%- for lane in site.reefer_lanes %}
  {%- assign l = site.data.live.reefer.lanes[lane.lane] %}
  <url>
    <loc>{{ lane.url | absolute_url | xml_escape }}</loc>
    {%- if l %}
    <lastmod>{{ l.last_iso | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor -%}
{%- assign crossings = site.border_crossings | concat: site.border_crossings_es | where_exp: "c", "c.sitemap != false" -%}
{%- for c in crossings %}
  <url>
    <loc>{{ c.url | absolute_url | xml_escape }}</loc>
    {%- if site.data.live.border %}
    <lastmod>{{ site.data.live.border.as_of_iso | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor -%}
{%- assign beef_pages = site.beef_cuts | concat: site.beef_cuts_es -%}
{%- for cut in beef_pages %}
  {%- assign c = site.data.live.beef.items[cut.cut] %}
  <url>
    <loc>{{ cut.url | absolute_url | xml_escape }}</loc>
    {%- if c %}
    <lastmod>{{ c.last_iso | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor -%}
{%- assign pork_pages = site.pork_cuts | concat: site.pork_cuts_es -%}
{%- for cut in pork_pages %}
  {%- assign c = site.data.live.pork.items[cut.cut] %}
  <url>
    <loc>{{ cut.url | absolute_url | xml_escape }}</loc>
    {%- if c %}
    <lastmod>{{ c.last_iso | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor -%}
{%- assign cattle_pages = site.cattle_regions | concat: site.cattle_regions_es -%}
{%- for reg in cattle_pages %}
  {%- assign c = site.data.live.cattle.items[reg.region] %}
  <url>
    <loc>{{ reg.url | absolute_url | xml_escape }}</loc>
    {%- if c %}
    <lastmod>{{ c.last_iso | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor -%}
{%- for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
{%- endfor %}
</urlset>
